# Medisense Backend Configuration
MEDISENSE_ENV=development
DATABASE_URL=sqlite:///./medisense.db

# AI Provider: 'demo' (safe offline deterministic engine), 'gemini', or 'openai'
AI_PROVIDER=demo
AI_API_KEY=your_optional_api_key_here

# Server configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

