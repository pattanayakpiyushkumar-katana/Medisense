# Medisense Backend Configuration
MEDISENSE_ENV=development
DATABASE_URL=sqlite:///./medisense.db

# AI Provider Configuration: Google Gemma 3:4B via Ollama
AI_PROVIDER=ollama
AI_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=30.0

# Optional API key placeholder (not required for local Ollama)
AI_API_KEY=

# Server configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
